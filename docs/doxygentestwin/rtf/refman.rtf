01066     EXPECT_EQ(ctx->list->size(), 2);\par
{\bkmkstart AAAAAAADFK}{\bkmkend AAAAAAADFK}
01067     EXPECT_EQ(ctx->stack->size(), 1);\par
{\bkmkstart AAAAAAADFL}{\bkmkend AAAAAAADFL}
01068     EXPECT_EQ(ctx->queue->size(), 2);\par
