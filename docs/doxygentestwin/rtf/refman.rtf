01069     EXPECT_EQ(ctx->graph->getVertexCount(), 2);\par
{\bkmkstart AAAAAAADFP}{\bkmkend AAAAAAADFP}
01070     EXPECT_EQ(ctx->sparseMatrix->getEntryCount(), 2);\par
{\bkmkstart AAAAAAADFQ}{\bkmkend AAAAAAADFQ}
01071 \}\par
